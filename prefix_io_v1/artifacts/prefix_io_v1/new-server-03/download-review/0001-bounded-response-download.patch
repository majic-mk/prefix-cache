+def test_automatic_redirect_never_reads_unmetered_response_payload():
+    class RedirectBody:
+        closed = False
+        def read(self, *args):
+            pytest.fail("urllib redirect read would consume unmetered payload")
+        def close(self):
+            self.closed = True
+    class Parent:
+        def open(self, *args, **kwargs):
+            pytest.fail("redirect must stop until an explicit provider route is approved")
+    handler = dl.VerifiedRedirect()
+    handler.add_parent(Parent())
+    req = urllib.request.Request("https://huggingface.co/first")
+    req.timeout = 10
+    body = RedirectBody()
+    with pytest.raises(RuntimeError, match="redirect"):
+        handler.http_error_302(req, body, 302, "Found",
+                               {"location": "https://huggingface.co/second"})
+    assert body.closed
