+class Response:
+    status = 200
+    def __init__(self, payload, url, length=True, fail_after=None, encoding="identity"):
+        self.stream = io.BytesIO(payload)
+        self.url = url
+        self.headers = {"Content-Encoding": encoding}
+        if length is True:
+            self.headers["Content-Length"] = str(len(payload))
+        elif length is not None:
+            self.headers["Content-Length"] = str(length)
+        self.fail_after = fail_after
+        self.closed = False
+        self.returned = 0
+        self.read_sizes = []
+    def geturl(self):
+        return self.url
+    def read(self, amount=-1):
+        self.read_sizes.append(amount)
+        if self.fail_after is not None and self.returned >= self.fail_after:
+            raise OSError("injected interrupted response")
+        if self.fail_after is not None:
+            amount = min(amount, self.fail_after - self.returned)
+        block = self.stream.read(amount)
+        self.returned += len(block)
+        return block
+    def __enter__(self):
+        return self
+    def __exit__(self, *exc):
+        self.close()
+    def close(self):
+        self.closed = True
+        self.stream.close()
+
