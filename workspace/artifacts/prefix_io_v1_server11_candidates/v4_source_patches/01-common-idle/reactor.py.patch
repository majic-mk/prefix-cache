+    def _has_poll_work(self) -> bool:
+        """Owner work that needs pumping, distinct from retained cache ownership.
+
+        Retained preload slots alone need no completion polling. New work and
+        STOP already wake the original incoming Queue; its existing timeout is
+        unchanged. Keep _has_work authoritative for shutdown and cleanup.
+        """
