+    assert budget["model_payload_received_bytes"] == rig.plan["total_bytes"]
+    assert budget["active_reservation"] is None
+    assert budget["gpu_wall_seconds"] == rig.initial["gpu_wall_seconds"]
+    assert budget["events"] == rig.initial["events"]
+    assert all(r.closed for r in rig.responses)
+    assert not list(rig.target.glob("*.partial"))
+    def no_request(*args):
+        pytest.fail("verified complete files must be reused without another request")
+    rig.open = no_request
+    second = rig.run("reuse")
