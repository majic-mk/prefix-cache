+             trace["cell_id"] == data["cell_id"] and trace["pair_id"] == run["pair_id"] and
+             TableContext.from_mapping(trace["context"]) == plan.context,
+             "complete trace version/origin/context/arm/cell/pair differs")
+    rows = trace["steps"]
