+"""CPU-only counterexamples and frozen-v3 equivalence for derived value reuse."""
+from __future__ import annotations
+import ast
+import cProfile
+from dataclasses import asdict, fields, is_dataclass, replace
+import importlib.util
+import os
+from pathlib import Path
+from types import SimpleNamespace as NS
+import unittest
+from unittest.mock import patch
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('_enriched_retry_support', HERE/'test_single_file_retry_observation.py')
+support = importlib.util.module_from_spec(spec); spec.loader.exec_module(support)
+from prefix_io_control import p4_bridge as bridge_module
+from prefix_io_control.p4_bridge import NativeP4Bridge
+from prefix_io_control.p4_policy import P4Policy
+from prefix_io_control.p4_types import P4Config
+
+default_base = HERE.with_name(HERE.name.replace('_v4', '_v3').replace('-v4-', '-v3-'))
+BASE = Path(os.environ.get('SERVER11_V3_CANDIDATE_ROOT', default_base))
+SOURCE = BASE/'source/third_party/work/prefix-io-p4-02-cpu/src/prefix_io_control/p4_bridge.py'
+parsed = ast.parse(SOURCE.read_text(encoding='utf-8-sig'))
+native = next(n for n in parsed.body if isinstance(n, ast.ClassDef) and n.name == 'NativeP4Bridge')
+method = next(n for n in native.body if isinstance(n, ast.FunctionDef) and n.name == 'preview_issue')
+baseline_namespace = dict(vars(bridge_module))
+exec(compile(ast.fix_missing_locations(ast.Module(body=[method], type_ignores=[])), str(SOURCE), 'exec'), baseline_namespace)
+V3_PREVIEW = baseline_namespace['preview_issue']
+
+
+class EnrichedSnapshotReuseTests(unittest.TestCase):
+    def fixture(self, *, shadow=False, config=None):
+        old = support.support.SingleFilePolicyTests()
+        old.setUp()
+        policy = (old.policy if config is None else P4Policy('r', config, single_file=old.receipt))
+        bridge = NativeP4Bridge(policy); bridge.bind(); bridge.single_file_shadow = shadow
+        bridge._single_file_runtime = NS(signature_prefix=old.receipt.signature[:4])
+        bridge._single_file_state = lambda: old.state
+        return old, bridge
+
+    def preview(self, fixture, bridge, **kwargs):
+        return bridge.preview_issue(kwargs.pop('work', fixture.work),
+            kwargs.pop('snapshot', fixture.snapshot), now_ns=kwargs.pop('now_ns', 30), **kwargs)
+
+    def test_repeated_values_still_run_original_policy_every_time(self):
+        f, b = self.fixture()
+        with patch.object(b.policy, 'issue_preview', wraps=b.policy.issue_preview) as policy:
+            with patch.object(bridge_module, 'replace', wraps=bridge_module.replace) as copies:
+                answers = [self.preview(f, b, now_ns=30+n) for n in range(8)]
+        self.assertTrue(all(answer == answers[0] for answer in answers))
+        self.assertEqual(policy.call_count, 8)
+        self.assertEqual(copies.call_count, 1)
+        cached = b._single_file_enriched_snapshot
+        self.assertIs(cached[0], f.snapshot)
+        self.assertEqual(cached[3].monotonic_ns, 25)
+        self.assertEqual(cached[3].native_state.captured_ns, 25)
+
+    def test_equal_but_new_original_snapshot_requires_new_derivation(self):
+        f, b = self.fixture(); self.preview(f, b)
+        previous = b._single_file_enriched_snapshot[3]
+        equal_snapshot = replace(f.snapshot)
+        self.assertEqual(f.snapshot, equal_snapshot)
+        self.preview(f, b, snapshot=equal_snapshot)
+        self.assertIsNot(b._single_file_enriched_snapshot[3], previous)
+        self.assertIs(b._single_file_enriched_snapshot[0], equal_snapshot)
+
+    def test_full_state_including_ordinal_and_boundaries_invalidates(self):
+        for state in ((6,10,20,1,1,0,144), (5,11,20,1,1,0,144), (5,10,21,1,1,0,144)):
+            f, b = self.fixture(); self.preview(f, b)
+            previous = b._single_file_enriched_snapshot[3]
+            b._single_file_state = lambda: state
+            self.assertEqual(self.preview(f, b).action, 'defer')
+            self.assertIsNot(b._single_file_enriched_snapshot[3], previous)
+            self.assertEqual(b._single_file_enriched_snapshot[1], state)
+
+    def test_runtime_prefix_change_fails_original_signature_check_and_clears(self):
+        f, b = self.fixture(); self.preview(f, b)
+        b._single_file_runtime.signature_prefix = ('different', *f.receipt.signature[1:4])
+        self.assertEqual(self.preview(f, b).reason, 'outside_verified_single_file_condition')
+        self.assertIsNone(b._single_file_enriched_snapshot)
+
+    def test_unknown_or_expired_state_clears_without_refresh(self):
+        for variant in ('unknown', 'snapshot_expired', 'live_state_expired'):
+            f, b = self.fixture(); self.preview(f, b)
+            original = b._single_file_enriched_snapshot[3]
+            if variant == 'unknown':
+                b._single_file_state = lambda: None
+                result = self.preview(f, b)
+            elif variant == 'snapshot_expired':
+                result = self.preview(f, b, now_ns=126)
+            else:
+                # Snapshot is still fresh at age 100; the original completed
+                # query is already age 105. Both times remain unchanged.
+                result = self.preview(f, b, now_ns=125)
+            self.assertEqual(result.action, 'native_fallback')
+            self.assertIsNone(b._single_file_enriched_snapshot)
+            self.assertEqual((original.monotonic_ns, original.native_state.captured_ns), (25,25))
+
+    def test_second_live_check_is_required_even_on_cache_hit(self):
+        f, b = self.fixture(); self.preview(f, b)
+        states = iter((f.state, None))
+        b._single_file_state = lambda: next(states)
+        self.assertEqual(self.preview(f, b).reason, 'single_file_step_ended_during_preview')
+        self.assertIsNone(b._single_file_enriched_snapshot)
+        self.assertIsNone(b._last_single_file_step)
+
+    def test_live_end_before_record_never_records_cached_deferral(self):
+        f, b = self.fixture(); self.preview(f, b)
+        b._single_file_state = lambda: None
+        self.assertFalse(b.record_single_file_deferral(f.work.work_id, at_ns=31))
+        self.assertEqual(b.single_file_blocked_attempts, 0)
+        self.assertIsNone(b._single_file_enriched_snapshot)
+
+    def test_progress_override_and_original_wait_limit_still_issue(self):
+        f, b = self.fixture(); self.preview(f, b)
+        result = self.preview(f, b, work=replace(f.work, progress='mandatory'))
+        self.assertEqual((result.action,result.reason), ('issue','native_progress_override'))
+        self.assertIsNone(b._single_file_enriched_snapshot)
+        f, b = self.fixture(config=P4Config('interference',10000,1000,100))
+        self.preview(f, b)
+        result = self.preview(f, b, now_ns=1005)
+        self.assertEqual(result.reason, 'native_progress_override')
+        self.assertIsNone(b._single_file_enriched_snapshot)
+        self.assertEqual(f.work.created_ns, 5)
+
+    def test_fault_immediately_drops_derived_value(self):
+        f, b = self.fixture(); self.preview(f, b)
+        b.fail('CPU counterexample')
+        self.assertIsNone(b._single_file_enriched_snapshot)
+        self.assertEqual(self.preview(f, b).reason, 'optional_bridge_fault')
+
+    def test_shadow_never_retains_cache_or_changes_native_issue(self):
+        f, b = self.fixture(shadow=True)
+        for _ in range(3):
+            self.assertEqual(self.preview(f, b).reason, 'single_file_shadow_preserves_native_issue')
+            self.assertIsNone(b._single_file_enriched_snapshot)
+        self.assertEqual(b.single_file_blocked_attempts, 0)
+
+    def test_retained_values_have_no_runner_capture_ready_or_mutable_owners(self):
+        f, b = self.fixture(); self.preview(f, b)
+        def walk(value):
+            if value is None or type(value) in (str,int,bool,bytes):
+                return
+            if type(value) in (tuple,frozenset):
+                for child in value: walk(child)
+                return
+            self.assertTrue(is_dataclass(value))
+            self.assertTrue(value.__dataclass_params__.frozen)
+            for field in fields(value): walk(getattr(value,field.name))
+        walk(b._single_file_enriched_snapshot)
+
+    def test_frozen_v3_preview_matrix_and_counters_match(self):
+        def run(method):
+            f, b = self.fixture()
+            result = []
+            for step in ('initial','reuse','equal_snapshot','new_step','mandatory','expired','unknown','shadow','fault'):
+                snapshot, work, now = f.snapshot, f.work, 30
+                if step == 'equal_snapshot': snapshot = replace(snapshot)
+                if step == 'new_step': b._single_file_state = lambda: (6,10,20,1,1,0,144)
+                if step == 'mandatory': work = replace(work, progress='mandatory')
+                if step == 'expired': now = 126
+                if step == 'unknown': b._single_file_state = lambda: None
+                if step == 'shadow':
+                    b._single_file_state = lambda: f.state
+                    b.single_file_shadow = True
+                if step == 'fault': b.fail('same CPU fixture fault')
+                result.append(asdict(method(b, work, snapshot, now_ns=now)))
+            return result, b.single_file_previews, b.single_file_deferrals, b.single_file_reasons
+        self.assertEqual(run(V3_PREVIEW), run(NativeP4Bridge.preview_issue))
+
+    def test_exact_155_original_retry_calls_reduce_replace_156_to_2(self):
+        def replay(method):
+            owner = support.Owner(max_wait=10**12)
+            prof = cProfile.Profile()
+            with patch.object(NativeP4Bridge, 'preview_issue', method):
+                prof.enable()
+                for _ in range(155): self.assertFalse(owner.repeat())
+                prof.disable()
+            prof.create_stats()
+            copies = sum(values[1] for (filename,line,name), values in prof.stats.items()
+                         if name == 'replace' and filename.endswith('dataclasses.py'))
+            facts = (owner.collects,owner.bridge.single_file_previews,
+                     owner.bridge.single_file_observation_reuses,
+                     owner.bridge.single_file_blocked_attempts,
+                     owner.staging_pool.reserves,owner.staging_pool.releases,
+                     owner.staging_pool.free_count,owner.ready.open_start_ns,
+                     owner._prefix_single_file_retry[1].monotonic_ns,
+                     owner._prefix_single_file_retry[1].native_state.captured_ns)
+            return copies, facts
+        before, after = replay(V3_PREVIEW), replay(NativeP4Bridge.preview_issue)
+        self.assertEqual((before[0],after[0]), (156,2))
+        self.assertEqual(before[1],after[1])
+        self.assertEqual(after[1],(1,155,154,155,155,155,16,100,1000,1000))
+
+
+if __name__ == '__main__': unittest.main()
