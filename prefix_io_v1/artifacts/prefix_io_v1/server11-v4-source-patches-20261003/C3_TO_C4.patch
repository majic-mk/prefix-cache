+"""CPU-only counterexamples and frozen-v3 equivalence for derived value reuse."""
+from __future__ import annotations
+import ast
+import cProfile
+from dataclasses import asdict, fields, is_dataclass, replace
+import importlib.util
+import os
+from pathlib import Path
+from types import SimpleNamespace as NS
+import unittest
+from unittest.mock import patch
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('_enriched_retry_support', HERE/'test_single_file_retry_observation.py')
+support = importlib.util.module_from_spec(spec); spec.loader.exec_module(support)
+from prefix_io_control import p4_bridge as bridge_module
+from prefix_io_control.p4_bridge import NativeP4Bridge
+from prefix_io_control.p4_policy import P4Policy
+from prefix_io_control.p4_types import P4Config
+
+default_base = HERE.with_name(HERE.name.replace('_v4', '_v3').replace('-v4-', '-v3-'))
+BASE = Path(os.environ.get('SERVER11_V3_CANDIDATE_ROOT', default_base))
+SOURCE = BASE/'source/third_party/work/prefix-io-p4-02-cpu/src/prefix_io_control/p4_bridge.py'
+parsed = ast.parse(SOURCE.read_text(encoding='utf-8-sig'))
+native = next(n for n in parsed.body if isinstance(n, ast.ClassDef) and n.name == 'NativeP4Bridge')
+method = next(n for n in native.body if isinstance(n, ast.FunctionDef) and n.name == 'preview_issue')
+baseline_namespace = dict(vars(bridge_module))
+exec(compile(ast.fix_missing_locations(ast.Module(body=[method], type_ignores=[])), str(SOURCE), 'exec'), baseline_namespace)
+V3_PREVIEW = baseline_namespace['preview_issue']
+
+
+class EnrichedSnapshotReuseTests(unittest.TestCase):
+    def fixture(self, *, shadow=False, config=None):
+        old = support.support.SingleFilePolicyTests()
+        old.setUp()
+        policy = (old.policy if config is None else P4Policy('r', config, single_file=old.receipt))
+        bridge = NativeP4Bridge(policy); bridge.bind(); bridge.single_file_shadow = shadow
+        bridge._single_file_runtime = NS(signature_prefix=old.receipt.signature[:4])
+        bridge._single_file_state = lambda: old.state
+        return old, bridge
+
+    def preview(self, fixture, bridge, **kwargs):
+        return bridge.preview_issue(kwargs.pop('work', fixture.work),
+            kwargs.pop('snapshot', fixture.snapshot), now_ns=kwargs.pop('now_ns', 30), **kwargs)
