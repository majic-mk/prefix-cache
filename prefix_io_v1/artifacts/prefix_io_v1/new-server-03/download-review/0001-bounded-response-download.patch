+        self.root = tmp_path / "project"
+        self.root.mkdir()
+        self.target = self.root / "models/qwen"
+        self.manifest = self.root / "manifest.json"
+        self.ledger = self.root / "experiments/prefix_io_v1/gpu-budget-ledger.json"
+        self.ledger.parent.mkdir(parents=True)
+        p = self.ledger.parent / "configs/permissions.yaml"
+        p.parent.mkdir()
+        self.permission_path = p
+        self.permissions = {
+            "schema_version": 1,
+            "allow_project_local_edits": True, "allow_cpu_tests": True,
+            "allow_public_source_read": True, "allow_remote_push": False,
+            "allow_new_cloud_rental": False, "allow_payment": False,
+            "allow_driver_or_system_changes": False, "allow_shared_data_deletion": False,
+            "allow_gpu_runs": True, "allow_model_downloads": True,
+            "max_gpu_hours": 8, "max_model_download_gib": 20,
+            "approved_gpu_ids": ["GPU-8b500efe-1a50-0e8e-b21e-716807eebedf"],
+            "approved_experiment_root": str(self.root / "experiments/prefix_io_v1/runs"),
+            "approved_dependency_root": str(self.root),
+        }
+        self.save_permissions()
+        self.initial = {"gpu_wall_seconds": 45.273048002272844,
+                        "model_download_bytes": 0,
+                        "events": [{"label": "historical_gpu_event", "elapsed_seconds": 45.273048002272844}],
+                        "active_reservation": None}
+        self.save_budget(self.initial)
+        self.payloads = {
+            "config.json": b'{"model_type":"qwen2","architectures":["Qwen2ForCausalLM"]}',
+            "tokenizer_config.json": b'{"tokenizer_class":"Qwen2Tokenizer"}',
+            "tokenizer.json": b'{"version":"1.0"}',
+            "model.safetensors.index.json": json.dumps({"weight_map": {"weight": WEIGHT}}).encode(),
+            WEIGHT: b"CPU fixture bytes, not model weights." * 4,
+        }
+        self.plan = {"schema_version": 1, "model_id": dl.MODEL_ID, "revision": REV,
+                     "source": "https://huggingface.co", "trust_remote_code": False, "files": []}
+        for name, payload in self.payloads.items():
+            algorithm = "sha256" if name.endswith(".safetensors") else "git_blob_sha1"
+            digest = (hashlib.sha256(payload).hexdigest() if algorithm == "sha256" else
+                      hashlib.sha1(b"blob " + str(len(payload)).encode() + b"\0" + payload).hexdigest())
+            self.plan["files"].append({
+                "path": name, "bytes": len(payload), "hash_algorithm": algorithm, "hash": digest,
+                "url": f"https://huggingface.co/{dl.MODEL_ID}/resolve/{REV}/{name}"})
+        self.plan["total_bytes"] = sum(len(p) for p in self.payloads.values())
+        self.save_plan()
+        self.requests = []
+        self.responses = []
+        self.response_factory = lambda req, rec: Response(self.payloads[rec["path"]], req.full_url)
+        self.on_open = None
+        monkeypatch.setattr(dl, "make_opener", lambda: self)
+        monkeypatch.setattr(dl.shutil, "disk_usage",
+                            lambda path: SimpleNamespace(free=100 * dl.GIB))
+    def save_plan(self):
+        self.manifest.write_text(json.dumps(self.plan))
+    def save_permissions(self):
+        self.permission_path.write_text(yaml.safe_dump(self.permissions))
+    def save_budget(self, value):
+        self.ledger.write_text(json.dumps(value))
+    def budget(self):
+        return json.loads(self.ledger.read_text())
+    def open(self, req, timeout):
+        reservation = self.budget()["active_reservation"]
+        assert reservation is not None and reservation["kind"] == "model_download"
+        rec = next(r for r in self.plan["files"] if r["url"] == req.full_url)
+        assert reservation["file"] == rec["path"]
+        assert reservation["reserved_bytes"] == rec["bytes"] + 1
+        assert req.get_header("Accept-encoding") == "identity"
+        if self.on_open:
+            self.on_open(req, rec)
+        self.requests.append(req)
+        response = self.response_factory(req, rec)
+        self.responses.append(response)
+        return response
+    def run(self, label="cpu-review"):
+        return dl.execute(self.root, self.manifest, self.target, label)
